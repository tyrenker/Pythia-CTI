# Pythia configuration — copy to .env and fill in
# Never commit .env

# --- API ---
PYTHIA_ENV=development
# Default 127.0.0.1 = localhost only. Set to 0.0.0.0 to expose on your LAN.
PYTHIA_HOST=127.0.0.1
PYTHIA_PORT=8000
PYTHIA_LOG_LEVEL=INFO

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PYTHIA_API_KEY=changeme-generate-a-strong-key

# --- Database ---
# Local dev (default): SQLite file
PYTHIA_DATABASE_URL=sqlite:///./pythia.db
# Production example:
# PYTHIA_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/pythia

# --- Claude / Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
PYTHIA_CLAUDE_MODEL=claude-sonnet-4-6

# --- Ingestion ---
PYTHIA_SCRAPE_USER_AGENT=Pythia/0.1 (+https://github.com/tyrenker/Pythia-CTI)
PYTHIA_SCRAPE_RATE_LIMIT_PER_MIN=20

# --- OTX ---
OTX_API_KEY=your_key_here

# --- Tor / Dark Web ---
PYTHIA_TOR_HOST=127.0.0.1
PYTHIA_TOR_SOCKS_PORT=9050
PYTHIA_TOR_CONTROL_PORT=9051
PYTHIA_TOR_CONTROL_PASSWORD=pythia-tor-password
PYTHIA_TOR_REQUIRED=false
PYTHIA_DARK_WEB_AUTO_INGEST=false
PYTHIA_DARK_WEB_MAX_PER_RUN=5

# --- Honeypot ---
# Set to true once your T-Pot VPS is sending events via Filebeat
PYTHIA_HONEYPOT_INGEST_ENABLED=false

# --- IP Enrichment (all free tier) ---
ABUSEIPDB_API_KEY=your_key_here           # abuseipdb.com — free 1,000 checks/day
GREYNOISE_API_KEY=your_key_here           # greynoise.io — free community key
VIRUSTOTAL_API_KEY=your_key_here          # virustotal.com — free 4 lookups/min
MAXMIND_DB_PATH=data/geoip/GeoLite2-City.mmdb   # place .mmdb files in data/geoip/ (download free from maxmind.com)
MAXMIND_ASN_DB_PATH=data/geoip/GeoLite2-ASN.mmdb

# --- SIEM Integration ---
PYTHIA_SIEM_TYPE=                         # wazuh | splunk | elastic | (blank = disabled)
PYTHIA_SIEM_URL=https://192.168.1.50:55000
PYTHIA_SIEM_USERNAME=wazuh-user
PYTHIA_SIEM_PASSWORD=changeme
PYTHIA_SIEM_API_TOKEN=                    # Elastic only — leave blank for Wazuh/Splunk